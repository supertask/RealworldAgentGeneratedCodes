    "implementation_order": [
      {
        "step": 1,
        "phase": 1,
        "description": "プロジェクト基盤構築：依存関係と設定ファイルの作成",
        "estimated_time": "1-2時間"
      },
      {
        "step": 2,
        "phase": 2,
        "description": "データモデル定義：材料と設計図のクラス設計",
        "estimated_time": "3-4時間"
      },
      {
        "step": 3,
        "phase": 3,
        "description": "データ入力処理：各形式のローダー実装",
        "estimated_time": "4-6時間"
      },
      {
        "step": 4,
        "phase": 4,
        "description": "構造計算エンジン：計算ロジックの実装（最重要）",
        "estimated_time": "10-15時間"
      },
      {
        "step": 5,
        "phase": 5,
        "description": "レポート生成：結果の可視化と出力",
        "estimated_time": "4-6時間"
      },
      {
        "step": 6,
        "phase": 6,
        "description": "ユーザーインターフェース：CLI/GUIの実装",
        "estimated_time": "4-6時間"
      },
      {
        "step": 7,
        "phase": 7,
        "description": "テストとドキュメント：品質保証と説明資料",
        "estimated_time": "6-8時間"
      },
      {
        "step": 8,
        "phase": 8,
        "description": "統合とデプロイ：全体の統合と最終調整",
        "estimated_time": "2-3時間"
      }
    ],
    "directory_structure": {
      "/workspace": {
        "src/": {
          "models/": "データモデル定義",
          "io/": "データ入出力処理",
          "calculator/": "構造計算エンジン",
          "report/": "レポート生成",
          "ui/": "ユーザーインターフェース"
        },
        "tests/": "テストコード",
        "docs/": "ドキュメント",
        "config/": "設定ファイル",
        "data/": "サンプルデータ（実行時生成）",
        "etc/tmp/": "一時ファイル保存用"
      }
    },
    "key_dependencies": {
      "external_libraries": [
        "pandas: データ処理",
        "numpy: 数値計算",
        "openpyxl: Excelファイル処理",
        "matplotlib: グラフ描画",
        "reportlab: PDFレポート生成",
        "click: CLIフレームワーク",
        "pytest: テストフレームワーク"
      ],
      "internal_dependencies_flow": [
        "models → io → calculator → report → ui → main"
      ]
    },
    "design_principles": [
      "非専門家でも理解できるコメント・ドキュメント",
      "計算式には数学的根拠と建築基準の参照を明記",
      "モジュール間の依存を最小化",
      "テストカバレッジ80%以上を目指す",
      "エラーメッセージは分かりやすく日本語で表示"
    ]
  },
  "notes": {
    "スプレッドシート形式": "Excel (.xlsx)、CSV (.csv) に対応",
    "マジックSP形式": "詳細仕様が必要な場合は追加で確認が必要",
    "構造計算の範囲": "具体的な計算範囲（RC造、鉄骨造、木造等）の明確化が必要",
    "建築基準": "適用する建築基準法・告示の年度を明確にする"
  }
}
